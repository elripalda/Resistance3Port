#version 450
// Temporal upscaler output + the original alpha -> an image the size and
// format of the scene target (RPCS3 VKR2Upscaler's r2aa_merge_pass).
// Built twice: rgba8 and -DMERGE_F16 (rgba16f).
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D ResultIn;
layout(set = 0, binding = 1) uniform sampler2D OrigIn;
#ifdef MERGE_F16
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D FinalOut;
#else
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D FinalOut;
#endif
// opts: x swap R/B, yz output size, w debug view; opts2.xy: render/output
layout(push_constant) uniform PC { vec4 opts; vec4 opts2; };
void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(opts.y) || p.y >= int(opts.z)) return;
    ivec2 q = ivec2((vec2(p) + 0.5) * opts2.xy);
    vec3 c = texelFetch(ResultIn, p, 0).rgb;
    if (any(isnan(c))) c = texelFetch(OrigIn, q, 0).rgb;
    if (opts.w > 1.5) { if (p.x < int(opts.y) / 2) c = texelFetch(OrigIn, q, 0).rgb; }
    else if (opts.w > 0.5) c = min(abs(c - texelFetch(OrigIn, q, 0).rgb) * 8.0, vec3(1.0));
    vec4 r = vec4(c, texelFetch(OrigIn, q, 0).a);
    if (opts.x > 0.5) r = r.bgra;
    imageStore(FinalOut, p, r);
}
