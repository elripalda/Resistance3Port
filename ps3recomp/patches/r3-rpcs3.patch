+{
+	void r2log(const char* fmt, ...)
+	{
+		char buf[1024];
+		va_list ap;
+		va_start(ap, fmt);
+		std::vsnprintf(buf, sizeof(buf), fmt, ap);
+		va_end(ap);
+		std::printf("[r2aa] %s\n", buf);
+		std::fflush(stdout);
+	}
+
+	struct r2aa_settings
+	{
+		int mode = 0;          // 0 off, 1 FSR 3.1, 2 DLAA
+		float sharpness = 0.f; // RSX_SHARPEN 0..1
+		float upscale = 1.f;   // RSX_UPSCALE: scene render scale (1 = native AA, <1 = upscaling)
+		float jsign = 1.f;     // RSX_AA_JITTER_SIGN=-1 flips the jitter handed to FSR/DLSS
+		unsigned preset = 0;   // RSX_DLSS_PRESET
+		int phases = 8;
+		bool debug = false;    // RSX_AA_DEBUG=1: more logging
+		int trace = 0;         // RSX_AA_TRACE=N: dump every draw of every N-th frame (pass structure analysis)
+		int view = 0;          // RSX_AA_DEBUG_VIEW=1: show |AA - input| x8; 2: left half input, right half AA
+		bool mask = true;      // RSX_DLSS_MASK=0: no moving-object mask (DLSS bias-current-colour)
+		// RSX_AA_SPLIT=0: frame boundary at the flip (R2). Default: R3 renders the next frame's geometry pre-pass
+		// before the flip, so the logical frame ends after the material pass (scene-pair run without depth writes).
+		bool split = true;
+	};
+
+	const r2aa_settings& r2cfg()
+	{
+		static const r2aa_settings s = []
+		{
+			r2aa_settings r;
+			if (const char* e = std::getenv("RSX_FSR")) r.mode = std::atoi(e);
+			if (r.mode < 0 || r.mode > 2) r.mode = 0;
+			if (const char* e = std::getenv("RSX_SHARPEN")) r.sharpness = static_cast<float>(std::atof(e));
+			r.sharpness = std::fmin(std::fmax(r.sharpness, 0.f), 1.f);
+			if (const char* e = std::getenv("RSX_UPSCALE")) r.upscale = static_cast<float>(std::atof(e));
+			if (!(r.upscale > 0.f) || r.upscale > 0.995f) r.upscale = 1.f;
+			r.upscale = std::fmax(r.upscale, 0.25f);
+			if (const char* e = std::getenv("RSX_AA_JITTER_SIGN")) r.jsign = std::atof(e) < 0 ? -1.f : 1.f;
+			if (const char* e = std::getenv("RSX_DLSS_PRESET")) r.preset = static_cast<unsigned>(std::atoi(e));
+			if (const char* e = std::getenv("RSX_AA_PHASES")) r.phases = std::max(1, std::min(64, std::atoi(e)));
+			if (const char* e = std::getenv("RSX_AA_DEBUG")) r.debug = std::atoi(e) != 0;
+			if (const char* e = std::getenv("RSX_AA_TRACE")) r.trace = std::max(0, std::atoi(e));
+			if (const char* e = std::getenv("RSX_AA_DEBUG_VIEW")) r.view = std::atoi(e);
+			if (const char* e = std::getenv("RSX_DLSS_MASK")) r.mask = std::atoi(e) != 0;
+			if (const char* e = std::getenv("RSX_AA_SPLIT")) r.split = std::atoi(e) != 0;
+			if (r.mode)
+			{
+				if (r.upscale < 1.f) r.phases = std::max(r.phases, static_cast<int>(std::ceil(8.f / (r.upscale * r.upscale))));
+				r2log("mode %s, scene render scale %.0f%%, sharpen %.2f, %d jitter phases", r.mode == 2 ? "DLSS (FSR 3.1 fallback)" : "FSR 3.1",
+					r.upscale * 100.f, r.sharpness, r.phases);
+			}
+			return r;
+		}();
+		return s;
+	}
