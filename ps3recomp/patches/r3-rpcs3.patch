+
+// R2_DRAWLOG=<seconds>[:frames]: from the first frame <seconds> after the first
+// draw, write one line per draw and clear to logs\drawlog.txt for <frames>
+// frames (default 2) -- render targets, depth/stencil/blend state, clip and
+// viewport Z, and the program addresses.
+std::atomic<u32> g_r2_drawlog_frame{0};
+
+namespace
+{
+	struct r2_drawlog_t
+	{
+		int state = -1; // -1 unread, 0 off, 1 waiting, 2 logging, 3 done
+		double after_s = 0;
+		u32 frames = 2, first = 0, n = 0;
+		std::chrono::steady_clock::time_point t0;
+		std::FILE* f = nullptr;
+	} s_dl;
+
+	bool r2_drawlog_active()
+	{
+		if (s_dl.state < 0)
+		{
+			const char* e = std::getenv("R2_DRAWLOG");
+			s_dl.state = (e && *e) ? 1 : 0;
+			if (s_dl.state)
+			{
+				s_dl.after_s = std::atof(e);
+				if (const char* c = std::strchr(e, ':')) s_dl.frames = std::max(1, std::atoi(c + 1));
+				s_dl.t0 = std::chrono::steady_clock::now();
+			}
+		}
+		if (s_dl.state == 1 && std::chrono::duration<double>(std::chrono::steady_clock::now() - s_dl.t0).count() >= s_dl.after_s)
+		{
+			s_dl.state = 2;
+			s_dl.first = g_r2_drawlog_frame.load() + 1;
+			s_dl.f = std::fopen("logs\\drawlog.txt", "w");
+			if (!s_dl.f) s_dl.state = 0;
+		}
+		if (s_dl.state != 2) return false;
+		const u32 fr = g_r2_drawlog_frame.load();
+		if (fr < s_dl.first) return false;
+		if (fr >= s_dl.first + s_dl.frames)
+		{
+			std::fclose(s_dl.f);
+			s_dl.f = nullptr;
+			s_dl.state = 3;
+			return false;
+		}
+		return true;
+	}
+
+	void r2_drawlog_line(const rsx::rsx_state& r, const char* what, u32 extra)
+	{
+		const u32 fr = g_r2_drawlog_frame.load() - s_dl.first;
+		std::fprintf(s_dl.f,
+			"f%u #%u %s %u | rt tgt=%u fmt=%u a=%08X/%u b=%08X c=%08X d=%08X | z=%08X fmt=%u %ux%u"
+			" | ztest=%d func=%u zwrite=%d bounds=%d st=%d | blend=%d cmask=%d%d%d%d | clip=%g..%g vpz=%g+%g"
+			" | vp=%u fp=%08X | zclear=%08X\n",
+			fr, s_dl.n++, what, extra,
+			static_cast<u32>(r.surface_color_target()), static_cast<u32>(r.surface_color()),
+			r.surface_offset(0), r.surface_pitch(0), r.surface_offset(1), r.surface_offset(2), r.surface_offset(3),
+			r.surface_z_offset(), static_cast<u32>(r.surface_depth_fmt()), r.surface_clip_width(), r.surface_clip_height(),
+			r.depth_test_enabled(), static_cast<u32>(r.depth_func()), r.depth_write_enabled(), r.depth_bounds_test_enabled(), r.stencil_test_enabled(),
+			r.blend_enabled(), r.color_mask_r(0), r.color_mask_g(0), r.color_mask_b(0), r.color_mask_a(0),
+			r.clip_min(), r.clip_max(), r.viewport_offset_z(), r.viewport_scale_z(),
+			r.transform_program_start(), r.registers[NV4097_SET_SHADER_PROGRAM],
+			r.registers[NV4097_SET_ZSTENCIL_CLEAR_VALUE]);
+	}
+}
+
+u32 g_r2_fifo_methods = 0;
+
+// FIFO flow events into the same log, with the methods executed since the last one.
+void r2_drawlog_flow(const char* what, u32 from, u32 to)
+{
+	if (s_dl.state != 2 || !s_dl.f) return;
+	const u32 fr = g_r2_drawlog_frame.load();
+	if (fr < s_dl.first || fr >= s_dl.first + s_dl.frames) return;
+	std::fprintf(s_dl.f, "f%u -- %s %08X -> %08X (%u methods)\n", fr - s_dl.first, what, from, to, g_r2_fifo_methods);
+	g_r2_fifo_methods = 0;
+}
+
+// R2_DRAWLOG_M=1: every method of the first logged frame, run-length folded.
+void r2_drawlog_method(u32 reg, u32 value)
+{
+	if (s_dl.state != 2 || !s_dl.f) return;
+	static int on = -1;
+	if (on < 0) on = std::getenv("R2_DRAWLOG_M") ? 1 : 0;
+	if (!on || g_r2_drawlog_frame.load() != s_dl.first) return;
+	static u32 last_reg = ~0u, run = 0;
+	if (reg == last_reg && reg == 0) { run++; return; }
+	if (run) { std::fprintf(s_dl.f, "     m %04X x%u\n", last_reg, run); run = 0; }
+	last_reg = reg;
+	std::fprintf(s_dl.f, "     m %04X = %08X\n", reg, value);
+}
