+	void ffx_message(uint32_t type, const wchar_t* message)
+	{
+		char buf[512] = {};
+		WideCharToMultiByte(CP_UTF8, 0, message ? message : L"", -1, buf, sizeof(buf) - 1, nullptr, nullptr);
+		r2log("FSR 3.1 %s: %s", type == FFX_API_MESSAGE_TYPE_ERROR ? "error" : "warning", buf);
+	}
