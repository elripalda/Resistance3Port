@@ -0,0 +1,213 @@
+#pragma once
+
+// R2PORT: R2_RSX_PROF=1 counters for the Resistance 2 port. The bridge (r2rsx_bridge.cpp) sets
+// r2prof::enabled before the RSX thread starts and prints the totals every 5 s. Everything is a
+// no-op branch when disabled. Per-frame stats (frame_statistics_t) are folded in at frame end.
+
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#if defined(_WIN32) && (defined(_M_X64) || defined(__x86_64__))
+#include <intrin.h> // R2PORT round 7: __rdtsc for now_ns
+#endif
+
