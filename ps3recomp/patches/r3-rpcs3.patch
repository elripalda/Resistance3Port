+	bool ffx_load()
+	{
+		if (g_ffx.tried) return g_ffx.dll != nullptr;
+		g_ffx.tried = true;
+		const std::wstring path = exe_dir() + L"\\amd_fidelityfx_vk.dll";
+		g_ffx.dll = LoadLibraryW(path.c_str());
+		if (!g_ffx.dll)
+		{
+			r2log("amd_fidelityfx_vk.dll not found next to the game; FSR 3.1 unavailable");
+			return false;
+		}
+		g_ffx.create = reinterpret_cast<PfnFfxCreateContext>(GetProcAddress(g_ffx.dll, "ffxCreateContext"));
+		g_ffx.destroy = reinterpret_cast<PfnFfxDestroyContext>(GetProcAddress(g_ffx.dll, "ffxDestroyContext"));
+		g_ffx.dispatch = reinterpret_cast<PfnFfxDispatch>(GetProcAddress(g_ffx.dll, "ffxDispatch"));
+		if (!g_ffx.create || !g_ffx.destroy || !g_ffx.dispatch)
+		{
+			r2log("amd_fidelityfx_vk.dll has no FFX API exports");
+			g_ffx.dll = nullptr;
