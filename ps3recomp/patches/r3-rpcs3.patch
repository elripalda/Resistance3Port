+# ---------------------------------------------------------------------------
+# Vulkan: headers are vendored (Khronos Vulkan-Headers). The loader import
+# library comes from the Vulkan SDK when one is installed, else it is generated
+# from rpcs3_shim/vulkan/vulkan-1.def (the exports of the system vulkan-1.dll).
+# ---------------------------------------------------------------------------
+set(RPCS3_VULKAN_LIB "" CACHE FILEPATH "vulkan-1.lib to link (empty = SDK or generated)")
+if(NOT RPCS3_VULKAN_LIB AND DEFINED ENV{VULKAN_SDK} AND EXISTS "$ENV{VULKAN_SDK}/Lib/vulkan-1.lib")
+    set(RPCS3_VULKAN_LIB "$ENV{VULKAN_SDK}/Lib/vulkan-1.lib")
 endif()
