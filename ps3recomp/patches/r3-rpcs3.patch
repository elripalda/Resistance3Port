+namespace vk
+{
+	int r2aa_mode()
+	{
+		return r2cfg().mode;
+	}
+
+	void r2aa_extend_instance(std::vector<const char*>& extensions)
+	{
+		if (r2cfg().mode != 2 || !dlss_load() || !g_dlss.inst_count) return;
+
+		u32 count = 0;
+		vkEnumerateInstanceExtensionProperties(nullptr, &count, nullptr);
+		std::vector<VkExtensionProperties> props(count);
+		vkEnumerateInstanceExtensionProperties(nullptr, &count, props.data());
+		for (unsigned i = 0; i < g_dlss.inst_count; ++i)
+		{
+			const char* name = g_dlss.inst_exts[i];
+			bool ok = false;
+			for (const auto& p : props) ok = ok || std::strcmp(p.extensionName, name) == 0;
+			if (ok) push_unique(extensions, name);
+			else r2log("instance extension %s (NGX) is not supported", name);
+		}
+	}
+
+	void r2aa_extend_device(VkPhysicalDevice pdev, std::vector<const char*>& extensions,
+		VkPhysicalDeviceFeatures& features, VkPhysicalDeviceVulkan12Features& vulkan12, VkDeviceCreateInfo& info)
+	{
+		if (!r2cfg().mode) return;
+
+		u32 count = 0;
+		vkEnumerateDeviceExtensionProperties(pdev, nullptr, &count, nullptr);
+		std::vector<VkExtensionProperties> props(count);
+		vkEnumerateDeviceExtensionProperties(pdev, nullptr, &count, props.data());
+		auto supported = [&](const char* name)
+		{
+			for (const auto& p : props)
+				if (std::strcmp(p.extensionName, name) == 0) return true;
+			return false;
+		};
+
+		static VkPhysicalDevice16BitStorageFeatures s16{ .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_16BIT_STORAGE_FEATURES };
+		static VkPhysicalDeviceSubgroupSizeControlFeatures ssc{ .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SUBGROUP_SIZE_CONTROL_FEATURES };
+		static VkPhysicalDeviceVulkan12Features v12{ .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_VULKAN_1_2_FEATURES };
+		const bool has_ssc = supported(VK_EXT_SUBGROUP_SIZE_CONTROL_EXTENSION_NAME);
+
+		VkPhysicalDeviceFeatures2 f2{ .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2 };
+		s16.pNext = nullptr; ssc.pNext = nullptr; v12.pNext = nullptr;
+		f2.pNext = &s16;
+		s16.pNext = &v12;
+		if (has_ssc) v12.pNext = &ssc;
+		vkGetPhysicalDeviceFeatures2(pdev, &f2);
+
+		// FSR 3.1 picks its shader permutations from what the GPU supports, so enable what it may use
+		features.shaderInt16 |= f2.features.shaderInt16;
+		features.shaderImageGatherExtended |= f2.features.shaderImageGatherExtended;
+		features.shaderStorageImageExtendedFormats |= f2.features.shaderStorageImageExtendedFormats;
+		features.shaderStorageImageReadWithoutFormat |= f2.features.shaderStorageImageReadWithoutFormat;
+		features.shaderStorageImageWriteWithoutFormat |= f2.features.shaderStorageImageWriteWithoutFormat;
+		vulkan12.shaderFloat16 |= v12.shaderFloat16;
+		vulkan12.shaderInt8 |= v12.shaderInt8;
+		vulkan12.shaderSubgroupExtendedTypes |= v12.shaderSubgroupExtendedTypes;
+		vulkan12.storageBuffer8BitAccess |= v12.storageBuffer8BitAccess;
+
+		s16.pNext = const_cast<void*>(info.pNext);
+		info.pNext = &s16;
+
+		// FSR 3.1 loads the KHR-suffixed entry points, which vkGetDeviceProcAddr only returns when the extension is enabled
+		for (const char* name : { VK_KHR_GET_MEMORY_REQUIREMENTS_2_EXTENSION_NAME, VK_KHR_DEDICATED_ALLOCATION_EXTENSION_NAME })
+			if (supported(name)) push_unique(extensions, name);
+
+		if (has_ssc && ssc.subgroupSizeControl)
+		{
+			push_unique(extensions, VK_EXT_SUBGROUP_SIZE_CONTROL_EXTENSION_NAME);
+			ssc.pNext = const_cast<void*>(info.pNext);
+			info.pNext = &ssc;
+		}
+
+		if (r2cfg().mode == 2 && g_dlss.dll && !g_dlss.failed)
+		{
+			// NGX only runs on NVIDIA RTX: skip its extensions (and the NGX init) on other vendors
+			VkPhysicalDeviceProperties pp{};
+			vkGetPhysicalDeviceProperties(pdev, &pp);
+			if (pp.vendorID != 0x10DE)
+			{
+				g_dlss.failed = true;
+				r2aa_fallback(2, "not an NVIDIA GPU");
+			}
+		}
+		if (r2cfg().mode == 2 && g_dlss.dll && !g_dlss.failed)
+		{
+			for (unsigned i = 0; i < g_dlss.dev_count; ++i)
+			{
+				const char* name = g_dlss.dev_exts[i];
+				if (std::strcmp(name, "VK_EXT_buffer_device_address") == 0) continue; // core bufferDeviceAddress instead
+				if (supported(name)) push_unique(extensions, name);
+				else r2log("device extension %s (NGX) is not supported", name);
+			}
+			vulkan12.bufferDeviceAddress |= v12.bufferDeviceAddress;
+		}
+
+		info.enabledExtensionCount = static_cast<u32>(extensions.size());
+		info.ppEnabledExtensionNames = extensions.data();
+	}
+}
+namespace
+{
+	struct pair_tally
+	{
+		u32 count = 0;
+		u32 first_draw = 0;
+		u32 segments = 0;   // separate runs of consecutive draws into this pair (light pre-pass: geometry pass, then material pass)
+	};
+
+	// A scene draw's transform inputs, captured at draw time; its matrix is extracted only when the vote needs it
+	struct mvp_entry
+	{
+		u64 key = 0;
+		const vp_info* prog = nullptr;
+		u32 branch_bits = 0;
+		u32 const_off = 0;   // into the frame's constant arena (prog->reads.size() vec4, or 512 when indexed)
+		u8 state = 0;        // 0 not extracted, 1 ok, 2 failed
+		m4 M;
+	};
+
+	struct mvp_frame
+	{
+		std::vector<mvp_entry> e;
+		std::vector<float> consts;
+		void clear() { e.clear(); consts.clear(); } // keeps the capacity: no allocations once warmed up
+	};
+
+	// Open-addressed u64 -> u32 table, cleared in O(1) by bumping the generation (no allocations)
+	template <u32 N>
+	struct flat_map
+	{
+		struct slot { u64 key; u32 value; u32 gen; };
+		slot s[N]{};
+		u32 gen = 1;
+		void clear() { if (++gen == 0) { for (auto& x : s) x.gen = 0; gen = 1; } }
+		u32* find(u64 key, bool insert)
+		{
+			u32 i = static_cast<u32>((key * 0x9e3779b97f4a7c15ull) >> 40) & (N - 1);
+			for (u32 n = 0; n < N; ++n, i = (i + 1) & (N - 1))
+			{
+				if (s[i].gen != gen)
+				{
+					if (!insert) return nullptr;
+					s[i] = { key, 0, gen };
+					return &s[i].value;
+				}
+				if (s[i].key == key) return &s[i].value;
+			}
+			return nullptr; // full
+		}
+	};
+
+	struct r2aa_state
+	{
+		bool disabled = false;         // no usable backend: never jitter
+		bool checked = false;
+
+		// Scene chosen at the previous flip
+		bool scene_valid = false;
+		u32 scene_rt = 0, scene_ds = 0;
+		bool scene_changed = true;
+
+		// Per-frame
+		std::unordered_map<u64, pair_tally> tally;
+		pair_tally* last_tally = nullptr; // tally of last_tally_pair (node pointers stay valid until clear)
+		u64 last_tally_pair = ~0ull;
+		u64 last_pair = ~0ull;
+		u32 seg_count = 0, seg_target = 1; // scene-pair runs this frame / in the previous frame (AA after the last one)
+		u32 draw_index = 0;
+		u32 scene_draws = 0, scene_draws_last = 0;
+		bool aa_done = false;
+		bool cur_scene = false;        // the draw being set up is a scene draw
+		vk::render_target* rt_ptr = nullptr;
+		vk::render_target* ds_ptr = nullptr;
+		rsx::address_range32 rt_range{};
+		float vw = 0, vh = 0;
+		bool inverted = false;
+		screen_xform frame_S, last_S;
+
+		// Jitter: desired for this frame (pixels) and what the current vertex env contains
+		float jx = 0, jy = 0;
+		float baked_x = 0, baked_y = 0;
+		u32 frame = 0;
+
+		// Camera motion
+		mvp_frame cur_F, prev_F;
+		flat_map<1024> occurrences;
+		flat_map<1024> prev_index;     // prev_F key -> entry (built when the vote runs)
+		std::vector<std::unique_ptr<vp_info>> vp_all;
+		std::unordered_map<u64, vp_info*> vp_map;
+		vp_info* last_vp = nullptr;
+		alignas(16) float vp_scratch[512 * 4] = {};
+		u32 evals = 0, eval_fail = 0;
+		screen_xform prev_S;
+		bool prev_valid = false;
+		bool ran_ok = false;           // the upscaler processed this frame's scene
+		m4 last_T = m4_identity();
+
+		// Upscaler
+		int backend = 0;               // 1 FSR, 2 DLSS
+		bool dlss_ready = false;
+		u32 res_w = 0, res_h = 0;
+		VkFormat res_fmt = VK_FORMAT_UNDEFINED;
+		bool res_inverted = false;
+		bool need_reset = true;
+		std::unique_ptr<vk::viewable_image> color, depth, mv, out, final_img, depth_prev, mask;
+		bool depth_prev_valid = false;
+		std::chrono::steady_clock::time_point last_run{};
+		u32 runs = 0;
+		u32 vote_hits = 0, vote_total = 0;
+		std::string last_skip;
+		u32 stat_runs = 0, stat_resets = 0, stat_jitter = 0, stat_flips_noscene = 0, stat_wb_miss = 0; // diagnostics
+
+		// Upscaling: during the scene window (first scene-pair bind .. upscaler) every target with the scene's size
+		// renders with a reduced RPCS3 resolution scale; other targets (shadow maps etc.) stay at full resolution
+		bool window = false;
+		bool resolve_wait = false;     // upscaling: the game resolves the scene into its own address; upscale after that pass
+		bool section = false;          // the reduced scale is active right now
+		u16 win_w = 0, win_h = 0;
+		rsx::surface_scaling_config_t full_cfg{};
+		float ow = 0, oh = 0;          // output (full-resolution) size of the scene viewport
+		u32 res_ow = 0, res_oh = 0;
+		bool wb_pending = false;       // upscaled result waits for the full-resolution scene target
+		bool wb_armed = false;
+		u32 out_w = 0, out_h = 0;
+		u32 stat_wb_direct = 0;        // results written into a new full-resolution scene surface
+		u32 stat_wb_clipped = 0;       // results written into a slightly smaller scene surface (its overlap)
+		u64 stat_run_ns = 0;           // CPU time of the upscaler runs + writebacks (diagnostics)
+		u32 stat_run_n = 0;
+		u32 jitter_cooldown = 0;       // frames without jitter after the result could not be shown
+
+		// Stable upscaler input: the input is locked to the common (smallest) scene area seen so the DLSS/FSR
+		// context, its history and the output size stay the same when the scene target is bound with other sizes.
+		u32 lock_w = 0, lock_h = 0;
+		u32 lock_bigger = 0;           // consecutive runs with a larger scene than the lock
+		bool lock_up = false;          // the lock was taken while upscaling (reduced-scale window)
+		u32 switch_votes = 0;          // consecutive frames another scene pair won (scene hysteresis)
+
+		// Split frames (r2aa_settings::split)
+		bool run_scene = false;        // the current run of draws goes into the scene pair
+		u32 run_draws = 0, run_dw = 0; // its draws / draws with depth writes
+		bool mat_done = false;         // a material pass (scene-pair run without depth writes) has finished
+		bool boundary_pending = false; // the upscaler ran: start the next logical frame at the next scene bind
+		u32 flips_since = 0;           // flips since the last logical frame boundary
+	} g_r2;
+
+	void frame_boundary();
+
+	// All scene passes of the logical frame are done: the upscaler may run at the next non-scene target
+	bool scene_passes_done()
+	{
+		const auto& st = g_r2;
+		if (!r2cfg().split) return st.seg_count >= st.seg_target;
+		return st.mat_done || (st.run_scene && st.run_draws >= 8 && !st.run_dw);
+	}
+
+	void skip_once(const std::string& why)
+	{
+		if (g_r2.last_skip != why)
+		{
+			g_r2.last_skip = why;
+			r2log("not applied: %s", why.c_str());
+		}
+	}
+
+	struct run_timer
+	{
+		std::chrono::steady_clock::time_point t0 = std::chrono::steady_clock::now();
+		bool count;
+		explicit run_timer(bool count_run) : count(count_run) {}
+		~run_timer()
+		{
+			g_r2.stat_run_ns += static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count());
+			if (count) g_r2.stat_run_n++;
+		}
+	};
+
+	float halton(u32 index, u32 base)
+	{
+		float f = 1.f, r = 0.f;
+		while (index > 0)
+		{
+			f /= static_cast<float>(base);
+			r += f * static_cast<float>(index % base);
+			index /= base;
+		}
+		return r;
+	}
+
+	u64 mix64(u64 h, u64 v)
+	{
+		h ^= v + 0x9e3779b97f4a7c15ull + (h << 6) + (h >> 2);
+		return h;
+	}
+
+	bool own_backend_ready()
+	{
+		if (g_r2.checked) return !g_r2.disabled;
+		g_r2.checked = true;
+		bool fsr = false;
+#ifdef R2PORT_HAVE_FFX
+		fsr = ffx_load();
+#else
+		r2log("built without FidelityFX headers; FSR 3.1 unavailable");
+#endif
+		const bool dlss = r2cfg().mode == 2 && dlss_load() && !g_dlss.failed;
+		g_r2.disabled = !fsr && !dlss;
+		if (g_r2.disabled) r2aa_fallback(1, "no upscaler backend available");
+		return !g_r2.disabled;
+	}
+
+	// The vp_info of the current vertex program: the same program as last time is confirmed with one memcmp
+	const vp_info* vp_lookup(const RSXVertexProgram& prog)
+	{
+		auto& st = g_r2;
+		const u32 pc0 = prog.entry - prog.base_address;
+		const usz bytes = prog.data.size() * sizeof(u32);
+		if (const vp_info* l = st.last_vp; l && l->pc0 == pc0 && l->data.size() == prog.data.size() &&
+			(!bytes || std::memcmp(l->data.data(), prog.data.data(), bytes) == 0))
+		{
+			return l;
+		}
+		u64 h = mix64(0x51ed27069e3779b9ull, pc0);
+		for (u32 w : prog.data) h = mix64(h, w);
+		if (const auto it = st.vp_map.find(h); it != st.vp_map.end())
+		{
+			vp_info* pi = it->second;
+			if (pi->pc0 == pc0 && pi->data == prog.data)
+			{
+				st.last_vp = pi;
+				return pi;
+			}
+		}
+		if (st.vp_all.size() >= 8192) return nullptr; // runaway program churn: stop collecting
+		auto pi = std::make_unique<vp_info>();
+		pi->data = prog.data;
+		pi->pc0 = pc0;
+		vp_analyse(*pi);
+		st.last_vp = pi.get();
+		st.vp_map[h] = pi.get(); // a (never seen) hash collision only replaces the lookup; the old entry stays owned
+		st.vp_all.push_back(std::move(pi));
+		return st.last_vp;
+	}
+
+	// Extract (once) the matrix of a captured draw. 'before' is the previous entry of the same frame: identical
+	// inputs give the identical matrix, so its result is reused.
+	bool resolve_entry(mvp_frame& f, u32 index)
+	{
+		auto& e = f.e[index];
+		if (e.state) return e.state == 1;
+		const vp_info& pi = *e.prog;
+		const float* src = f.consts.data() + e.const_off;
+		const usz nfl = pi.indexed ? 512 * 4 : pi.reads.size() * 4;
+		if (index)
+		{
+			const auto& b = f.e[index - 1];
+			if (b.state && b.prog == e.prog && b.branch_bits == e.branch_bits &&
+				std::memcmp(f.consts.data() + b.const_off, src, nfl * sizeof(float)) == 0)
+			{
+				e.state = b.state;
+				e.M = b.M;
+				return e.state == 1;
+			}
+		}
+		const float* consts = src;
+		if (!pi.indexed)
+		{
+			// Only the constants the program reads are needed (the rest of the scratch block is never read)
+			float* s = g_r2.vp_scratch;
+			for (usz k = 0; k < pi.reads.size(); ++k) std::memcpy(s + pi.reads[k] * 4, src + k * 4, 4 * sizeof(float));
+			consts = s;
+		}
+		e.state = vp_extract_matrix(pi.code(), consts, e.branch_bits, e.M) ? 1 : 2;
+		return e.state == 1;
+	}
+
+	// Camera motion R = M_prev * M_cur^-1, voted over all draws present in both frames
+	bool vote_camera(m4& R, u32& matched, u32& members)
+	{
+		auto& st = g_r2;
+		st.prev_index.clear();
+		for (u32 i = 0; i < st.prev_F.e.size(); ++i)
+			if (u32* v = st.prev_index.find(st.prev_F.e[i].key, true)) *v = i;
+
+		static std::vector<m4> rs; // reused: no per-frame allocation
+		rs.clear();
+		for (u32 i = 0; i < st.cur_F.e.size(); ++i)
+		{
+			const u32* pi = st.prev_index.find(st.cur_F.e[i].key, false);
+			if (!pi) continue;
+			if (!resolve_entry(st.cur_F, i)) { st.eval_fail++; continue; }
+			if (!resolve_entry(st.prev_F, *pi)) continue;
+			m4 inv;
+			if (!m4_inverse(st.cur_F.e[i].M, inv)) continue;
+			const m4 r = m4_mul(st.prev_F.e[*pi].M, inv);
+			if (!std::isfinite(m4_maxabs(r))) continue;
+			rs.push_back(r);
+		}
+		matched = static_cast<u32>(rs.size());
+		members = 0;
+		if (rs.empty()) return false;
+
+		// At most 24 evenly spaced candidates, each counted against all matrices (was O(n^2) over up to 384)
+		usz best = 0;
+		const usz cands = std::min<usz>(rs.size(), 24);
+		for (usz c = 0; c < cands; ++c)
+		{
+			const usz i = c * rs.size() / cands;
+			const double tol = 1e-3 * (1.0 + m4_maxabs(rs[i]));
+			u32 n = 0;
+			for (usz j = 0; j < rs.size(); ++j)
+				if (m4_maxdiff(rs[i], rs[j]) <= tol) ++n;
+			if (n > members)
+			{
+				members = n;
+				best = i;
+			}
+			if (members * 2 > rs.size()) break; // majority found
+		}
+		R = rs[best];
+		return members >= 4 && members * 4 >= matched;
+	}
+}
+
+int VKGSRender::r2aa_on_draw()
+{
+	auto& st = g_r2;
+	st.cur_scene = false;
+	if (!r2cfg().mode || !own_backend_ready()) return 0;
+
+	const auto regs = REGS(m_ctx);
+	auto& sc = res()->surface_cache;
+	auto* rt = sc.m_bound_render_targets[0].second;
+	auto* ds = sc.m_bound_depth_stencil.second;
+	const u32 rt_addr = rt ? sc.m_bound_render_targets[0].first : 0;
+	const u32 ds_addr = ds ? sc.m_bound_depth_stencil.first : 0;
+	const bool dtest = regs->depth_test_enabled();
+	const bool dwrite = regs->depth_write_enabled();
+
+	const u64 pair = (static_cast<u64>(rt_addr) << 32) | ds_addr;
+	const bool new_run = pair != st.last_pair;
+	st.last_pair = pair;
+	if (ds_addr && (dtest || dwrite))
+	{
+		pair_tally* t = st.last_tally;
+		if (!t || st.last_tally_pair != pair)
+		{
+			t = &st.tally[pair];
+			st.last_tally = t;
+			st.last_tally_pair = pair;
+		}
+		if (!t->count) t->first_draw = st.draw_index;
+		t->count++;
+		if (new_run) t->segments++;
+	}
+	const bool scene_pair = st.scene_valid && rt_addr == st.scene_rt && ds_addr == st.scene_ds;
+	if (scene_pair && new_run) st.seg_count++;
+	if (new_run)
+	{
+		if (st.run_scene && st.run_draws >= 8 && !st.run_dw) st.mat_done = true;
+		st.run_scene = scene_pair;
+		st.run_draws = st.run_dw = 0;
+	}
+	if (scene_pair && (dtest || dwrite))
+	{
+		st.run_draws++;
+		if (dwrite) st.run_dw++;
+	}
+	st.draw_index++;
+
+	if (r2cfg().trace && (st.frame % static_cast<u32>(r2cfg().trace)) == 0 && st.frame)
+	{
+		const auto& vp = m_ctx->draw_state.viewport;
+		std::string tex;
+		for (u32 mask = m_ctx->program.fp_metadata.referenced_textures_mask, i = 0; mask; mask >>= 1, ++i)
+		{
+			if (!(mask & 1) || !regs->fragment_textures[i].enabled()) continue;
+			const auto& t = regs->fragment_textures[i];
+			char b[64];
+			std::snprintf(b, sizeof(b), " t%u=%08x(%ux%u)", i, rsx::get_address(m_ctx, t.offset(), t.location()), t.width(), t.height());
+			tex += b;
+		}
+		std::string mrt;
+		for (u32 i = 1; i < 4; ++i)
+		{
+			if (!sc.m_bound_render_targets[i].second) continue;
+			char b[32];
+			std::snprintf(b, sizeof(b), " rt%u=%08x", i, sc.m_bound_render_targets[i].first);
+			mrt += b;
+		}
+		const auto* dsimg = sc.m_bound_depth_stencil.second;
+		r2log("T f%u d%u rt=%08x(%ux%u fmt%d)%s ds=%08x(%ux%u) fbo=%ux%u vpx=%.0fx%.0f cfg=%u clip=%ux%u+%d,%d sc=%ux%u dt=%d dw=%d vp=%05x fp=%08x%s",
+			st.frame, st.draw_index - 1, rt_addr, rt ? rt->info.extent.width : 0, rt ? rt->info.extent.height : 0, rt ? static_cast<int>(rt->info.format) : 0,
+			mrt.c_str(), ds_addr, dsimg ? dsimg->info.extent.width : 0, dsimg ? dsimg->info.extent.height : 0,
+			m_draw_fbo ? m_draw_fbo->width() : 0, m_draw_fbo ? m_draw_fbo->height() : 0, m_viewport.width, m_viewport.height,
+			RSX(m_ctx)->resolution_scaling_config.scale_percent,
+			vp.clip_width, vp.clip_height, regs->surface_clip_origin_x(), regs->surface_clip_origin_y(),
+			regs->scissor_width(), regs->scissor_height(), dtest, dwrite,
+			m_ctx->program.vertex_program.base_address, regs->shader_program_address(), tex.c_str());
+	}
+	if (st.scene_valid && !st.aa_done && st.scene_draws && !scene_pair && scene_passes_done() && !st.resolve_wait)
+	{
+		// The last run of draws into the scene pair is over (R2 draws it twice: geometry pre-pass, then the
+		// material pass after the light passes). Anything else now (transparents, post, HUD): AA first.
+		r2aa_run();
+	}
+
+	if (st.scene_valid && !st.aa_done && ds_addr == st.scene_ds && (dtest || dwrite))
+	{
+		st.cur_scene = true;
+		st.scene_draws++;
+		st.ds_ptr = ds;
+		if (rt_addr == st.scene_rt)
+		{
+			st.rt_ptr = rt;
+			st.rt_range = rt->get_memory_range();
+		}
+
+		const auto& vp = m_ctx->draw_state.viewport;
+		const auto [cw, ch] = rsx::apply_resolution_scale<true>(RSX(m_ctx)->resolution_scaling_config, vp.clip_width, vp.clip_height);
+		st.vw = static_cast<float>(cw);
+		st.vh = static_cast<float>(ch);
+		const auto [fw, fh] = rsx::apply_resolution_scale<true>(st.window ? st.full_cfg : RSX(m_ctx)->resolution_scaling_config, vp.clip_width, vp.clip_height);
+		st.ow = static_cast<float>(fw);
+		st.oh = static_cast<float>(fh);
+		const auto func = regs->depth_func();
+		st.inverted = func == rsx::comparison_function::greater || func == rsx::comparison_function::greater_or_equal;
+		if (st.last_S.valid) st.frame_S = st.last_S;
+
+		if (st.evals < 384)
+		{
+			st.evals++;
+			const auto& prog = m_ctx->program.vertex_program;
+			u64 key = mix64(prog.base_address, prog.entry);
+			key = mix64(key, prog.data.size());
+			key = mix64(key, regs->vertex_arrays_info[0].offset());
+			key = mix64(key, regs->index_array_address());
+			u32* occ = st.occurrences.find(key, true);
+			key = mix64(key, occ ? (*occ)++ : 0xffffffffu);
+
+			// Capture only: the program (shared, by ucode) and the constants it reads. The matrix is extracted
+			// when the camera vote needs it (r2aa_run), for draws also present in the other frame.
+			if (const vp_info* pi = vp_lookup(prog))
+			{
+				auto& f = st.cur_F;
+				mvp_entry e;
+				e.key = key;
+				e.prog = pi;
+				e.branch_bits = regs->transform_branch_bits();
+				e.const_off = static_cast<u32>(f.consts.size());
+				const float* consts = reinterpret_cast<const float*>(regs->transform_constants.data());
+				if (pi->indexed)
+				{
+					f.consts.insert(f.consts.end(), consts, consts + 512 * 4);
+				}
+				else
+				{
+					const usz base = f.consts.size();
+					f.consts.resize(base + pi->reads.size() * 4);
+					float* dst = f.consts.data() + base;
+					for (const u16 c : pi->reads)
+					{
+						std::memcpy(dst, consts + c * 4, 4 * sizeof(float));
+						dst += 4;
+					}
+				}
+				f.e.push_back(e);
+			}
+			else
+			{
+				st.eval_fail++;
+			}
+		}
+	}
+
+	const float want_x = st.cur_scene ? st.jx : 0.f;
+	const float want_y = st.cur_scene ? st.jy : 0.f;
+	return (want_x != st.baked_x || want_y != st.baked_y) ? 1 : 0;
+}
+
+void VKGSRender::r2aa_patch_vertex_env(void* env)
+{
+	if (!r2cfg().mode || g_r2.disabled) return;
+	auto& st = g_r2;
+	float* f = static_cast<float*>(env);
+	st.last_S = { f[0], f[3], f[5], f[7], f[10], f[11], f[19], f[20], true };
+	st.baked_x = st.baked_y = 0.f;
+	if (!st.cur_scene) return;
+
+	st.frame_S = st.last_S;
+	if (st.vw > 0 && st.vh > 0)
+	{
+		f[3] += 2.f * st.jx / st.vw;
+		f[7] += 2.f * st.jy / st.vh;
+		st.baked_x = st.jx;
+		st.baked_y = st.jy;
+	}
+}
+
+void VKGSRender::r2aa_check_texture_reads()
+{
+	auto& st = g_r2;
+	if (!r2cfg().mode || st.disabled || !st.scene_draws || st.aa_done || !st.rt_ptr || !scene_passes_done()) return; // reads between the scene passes are the light passes
+	if (st.resolve_wait) return; // the resolve pass reads the scene; upscale its output once it is done
+
+	auto& sc = res()->surface_cache;
+	if (sc.m_bound_render_targets[0].second && sc.m_bound_render_targets[0].first == st.scene_rt) return;
+
+	const auto regs = REGS(m_ctx);
+	for (u32 mask = m_ctx->program.fp_metadata.referenced_textures_mask, i = 0; mask; mask >>= 1, ++i)
+	{
+		if (!(mask & 1)) continue;
+		const auto& tex = regs->fragment_textures[i];
+		if (!tex.enabled()) continue;
+		const u32 addr = rsx::get_address(m_ctx, tex.offset(), tex.location());
+		if (addr >= st.rt_range.start && addr <= st.rt_range.end)
+		{
+			r2aa_run();
+			return;
+		}
+	}
+}
+
+void VKGSRender::r2aa_before_bind(u32 color0, u32 zeta)
+{
+	auto& st = g_r2;
+	if (!r2cfg().mode || st.disabled) return;
+	const bool scene_bind = color0 == st.scene_rt && zeta == st.scene_ds;
+	if (st.boundary_pending && scene_bind && !st.window) frame_boundary();
+	if (st.scene_valid && st.scene_draws && !st.aa_done && st.rt_ptr && scene_passes_done() && !scene_bind)
+	{
+		auto& sc = res()->surface_cache;
+		if (st.resolve_wait)
+		{
+			// The resolve pass (and whatever it drew into the scene address) is done once another target is bound
+			if (color0 && color0 != st.scene_rt) r2aa_run();
+		}
+		else if (sc.m_bound_render_targets[0].first == st.scene_rt && sc.m_bound_depth_stencil.first == st.scene_ds)
+		{
+			if (st.window && (color0 == st.scene_rt || !color0))
+			{
+				// R2 resolves the (2x horizontal) scene into a plain target at the same address. Keep that pass inside
+				// the reduced-scale window and upscale its result: the full-scale scene layout is never rebuilt.
+				// A depth-only bind (depth clear) may come first.
+				st.resolve_wait = true;
+			}
+			else
+			{
+				r2aa_run();
+			}
+		}
+	}
+
+	const auto& layout = m_ctx->fb.layout;
+	if (st.window && st.aa_done)
+	{
+		// Scene window over: everything after it (transparents, post, HUD) renders at full resolution
+		st.window = false;
+		r2aa_set_section(false);
+		st.wb_armed = st.wb_pending;
+		st.wb_pending = false;
+		r2aa_writeback(); // before the next targets are bound: they may alias the scene memory (R2's quarter-size post buffers)
+	}
+	else if (!st.window && !st.aa_done && !st.scene_draws && st.scene_valid && scene_bind && r2cfg().upscale < 1.f)
+	{
+		st.window = true;
+		st.full_cfg = RSX(m_ctx)->resolution_scaling_config;
+		st.win_w = layout.width;
+		st.win_h = layout.height;
+	}
+	if (st.window)
+	{
+		r2aa_set_section(layout.width == st.win_w && layout.height == st.win_h);
+	}
+}
+
+void VKGSRender::r2aa_set_section(bool on)
+{
+	auto& st = g_r2;
+	if (on == st.section) return;
+	auto& cfg = RSX(m_ctx)->resolution_scaling_config;
+	if (on)
+	{
+		const float pct = std::round(static_cast<float>(cfg.scale_percent) * r2cfg().upscale);
+		cfg.scale_percent = static_cast<u16>(std::max(10.f, pct));
+		st.section = true;
+	}
+	else
+	{
+		cfg = st.full_cfg;
+		st.section = false;
+	}
+	// Viewport/scissor/WPOS and point size depend on the active scale
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::viewport);
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::scissor);
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::vertex_env);
+	m_ctx->draw_state.dirty.set(rsx::draw_state_t::group::fragment_env);
+}
+
+void VKGSRender::r2aa_writeback()
+{
+	auto& st = g_r2;
+	if (!st.wb_armed) return;
+	st.wb_armed = false;
+	run_timer timer(false);
+
+	auto& sc = res()->surface_cache;
+	auto& cmd = *m_current_command_buffer;
+	auto miss = [&](const std::string& why)
+	{
+		// Show the plain (scaled) frame
+		st.stat_wb_miss++;
+		st.jitter_cooldown = 10;
+		skip_once("upscaled scene could not be written back (" + why + ")");
+	};
+	if (!st.final_img) return miss("no result");
+
+	// Replace the reduced-scale scene surface with a full-resolution one holding the upscaled result. This runs before
+	// the next targets are bound, so whatever follows (post passes sampling the scene, or quarter-size buffers that
+	// alias its memory and inherit from it) sees the upscaled scene.
+	auto* old = sc.get_surface_at(st.scene_rt);
+	if (!old || old->is_depth_surface() || old->samples() > 1 || old->info.format != st.res_fmt)
+		return miss("scene surface gone");
+	if (vk::is_renderpass_open(cmd)) vk::end_renderpass(cmd);
+	auto* rt = old;
+	if (old->info.extent.width < st.out_w || old->info.extent.height < st.out_h)
+	{
+		rt = sc.r2_rescale_color_surface(cmd, old, st.full_cfg);
+		if (!rt) return miss("full-resolution surface could not be created");
+	}
+	// The surface now at the scene address may be another layout of the same memory: write the overlap.
+	const u32 cw = std::min(st.out_w, rt->info.extent.width);
+	const u32 ch = std::min(st.out_h, rt->info.extent.height);
+	if (cw * 4 < st.out_w * 3 || ch * 4 < st.out_h * 3)
+		return miss("full-resolution surface too small: " + std::to_string(rt->info.extent.width) + "x" + std::to_string(rt->info.extent.height) +
+			" for " + std::to_string(st.out_w) + "x" + std::to_string(st.out_h));
+	if ((cw < st.out_w || ch < st.out_h) && !st.stat_wb_clipped++)
+		r2log("upscaled scene %ux%u written to a %ux%u surface (overlap)", st.out_w, st.out_h, rt->info.extent.width, rt->info.extent.height);
+	if (!st.stat_wb_direct++) r2log("upscaled scene written to a %ux%u surface", rt->info.extent.width, rt->info.extent.height);
+	if (r2cfg().trace && (st.frame % static_cast<u32>(r2cfg().trace)) == 0 && st.frame)
+		r2log("T f%u WB old %ux%u (native %ux%u, %u%%) -> rt %ux%u (native %ux%u, %u%%) out %ux%u", st.frame,
+			old->info.extent.width, old->info.extent.height, old->get_surface_width(), old->get_surface_height(), old->resolution_scaling_config.scale_percent,
+			rt->info.extent.width, rt->info.extent.height, rt->get_surface_width(), rt->get_surface_height(), rt->resolution_scaling_config.scale_percent,
+			st.out_w, st.out_h);
+
+	rt->memory_barrier(cmd, rsx::surface_access::transfer_write); // pulls in the inherited (scaled) contents first
+	rt->push_layout(cmd, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+	VkImageCopy region{};
+	region.srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	region.dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 };
+	region.extent = { cw, ch, 1 };
+	vkCmdCopyImage(cmd, st.final_img->value, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, rt->value, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+	rt->pop_layout(cmd);
+	rt->on_write_copy(rsx::get_shared_tag());
+
+	cmd.r2_invalidate_state_cache();
+	m_current_command_buffer->flags |= vk::command_buffer::cb_reload_dynamic_state;
+	st.ran_ok = true;
+}
+
+void VKGSRender::r2aa_check_read(u32 address)
+{
+	auto& st = g_r2;
+	if (r2cfg().trace && (st.frame % static_cast<u32>(r2cfg().trace)) == 0 && st.frame) r2log("T f%u blit-read %08x", st.frame, address);
+	if (!r2cfg().mode || st.disabled || !st.scene_draws || st.aa_done || !st.rt_ptr || !scene_passes_done()) return; // reads between the scene passes are the light passes
+	if (st.resolve_wait) return; // the resolve pass reads the scene; upscale its output once it is done
+	if (address >= st.rt_range.start && address <= st.rt_range.end)
+	{
+		r2aa_run();
+	}
+}
+
+namespace
+{
+	// Next logical frame: pick its scene from this frame's draws, set its jitter
+	void frame_boundary()
+	{
+		auto& st = g_r2;
+		st.boundary_pending = false;
+		st.flips_since = 0;
+		st.mat_done = false;
+		st.run_scene = false;
+		st.run_draws = st.run_dw = 0;
+		// Pick next frame's scene: the depth buffer with most depth-tested draws, then its busiest colour target
+		u64 best_ds = 0;
+		{
+			std::unordered_map<u32, u32> per_ds;
+			u32 best = 0;
+			for (const auto& [key, t] : st.tally)
+			{
+				if (!(key >> 32)) continue; // depth-only (shadow maps) can't be the scene
+				const u32 ds = static_cast<u32>(key);
+				const u32 n = (per_ds[ds] += t.count);
+				if (n > best) { best = n; best_ds = ds; }
+			}
+		}
+
+		u32 max_count = 0;
+		for (const auto& [key, t] : st.tally)
+			if (static_cast<u32>(key) == best_ds && (key >> 32)) max_count = std::max(max_count, t.count);
+
+		bool found = false;
+		u32 new_rt = 0, latest_first = 0;
+		for (const auto& [key, t] : st.tally)
+		{
+			if (static_cast<u32>(key) != best_ds || !(key >> 32)) continue;
+			if (t.count < std::max(30u, max_count / 4)) continue;
+			if (!found || t.first_draw > latest_first)
+			{
+				found = true;
+				latest_first = t.first_draw;
+				new_rt = static_cast<u32>(key >> 32);
+			}
+		}
+
+		const bool was_valid = st.scene_valid;
+		const u32 old_rt = st.scene_rt, old_ds = st.scene_ds;
+		if (found && was_valid && (new_rt != old_rt || static_cast<u32>(best_ds) != old_ds))
+		{
+			// Hysteresis: frames where two pairs are close (menus over the game, cutscene transitions) must not flip
+			// the scene every frame (each switch resets the upscaler history). Switch once the other pair wins 3 frames
+			// in a row, or at once when the current scene pair was not drawn at all.
+			const auto it = st.tally.find((static_cast<u64>(old_rt) << 32) | old_ds);
+			const bool old_present = it != st.tally.end() && it->second.count >= 30;
+			if (old_present && ++st.switch_votes < 3)
+			{
+				new_rt = old_rt;
+				best_ds = old_ds;
+			}
+			else
+			{
+				st.switch_votes = 0;
+			}
+		}
+		else
+		{
+			st.switch_votes = 0;
+		}
+		st.scene_valid = found;
+		if (found)
+		{
+			st.scene_rt = new_rt;
+			st.scene_ds = static_cast<u32>(best_ds);
+		}
+		st.scene_changed = !was_valid || !found || old_rt != st.scene_rt || old_ds != st.scene_ds;
+		if (found)
+		{
+			const auto it = st.tally.find((static_cast<u64>(st.scene_rt) << 32) | st.scene_ds);
+			st.seg_target = it != st.tally.end() ? std::max(1u, it->second.segments) : 1u;
+		}
+		if (st.scene_changed && found)
+		{
+			r2log("scene: colour 0x%08x, depth 0x%08x (%u draws, %u passes)", st.scene_rt, st.scene_ds, max_count, st.seg_target);
+			st.need_reset = true;
+			st.lock_w = st.lock_h = 0;
+		}
+
+		if (r2cfg().debug && (st.frame % 300) == 0)
+		{
+			r2log("frame %u: %u scene draws, %u matrix evals (%u failed), vote %u/%u", st.frame, st.scene_draws, st.evals, st.eval_fail, st.vote_hits, st.vote_total);
+		}
+
+		// Next frame
+		st.prev_F.e.swap(st.cur_F.e);
+		st.prev_F.consts.swap(st.cur_F.consts);
+		st.cur_F.clear();
+		st.occurrences.clear();
+		st.tally.clear();
+		st.last_tally = nullptr;
+		st.last_tally_pair = ~0ull;
+		st.last_pair = ~0ull;
+		st.seg_count = 0;
+		st.prev_S = st.frame_S;
+		st.prev_valid = st.frame_S.valid && st.ran_ok;
+		// Jitter only while the upscaler is known to run on this scene: it ran last frame and the scene is unchanged.
+		// Otherwise (menus, loading screens, the first frame of a new scene, a failed pass) draw without jitter.
+		if (st.jitter_cooldown) st.jitter_cooldown--;
+		const bool jitter_on = st.ran_ok && st.scene_valid && !st.scene_changed && !st.jitter_cooldown;
+		st.ran_ok = false;
+		st.scene_draws_last = st.scene_draws;
+		st.scene_draws = 0;
+		st.draw_index = 0;
+		st.evals = st.eval_fail = 0;
+		st.aa_done = false;
+		st.rt_ptr = nullptr;
+		st.ds_ptr = nullptr;
+		st.frame_S.valid = false;
+		st.frame++;
+		g_r2_trace_now = r2cfg().trace && (st.frame % static_cast<u32>(r2cfg().trace)) < 2 && st.frame > 1;
+		const u32 phase = (st.frame % static_cast<u32>(r2cfg().phases)) + 1;
+		st.jx = jitter_on ? halton(phase, 2) - 0.5f : 0.f;
+		st.jy = jitter_on ? halton(phase, 3) - 0.5f : 0.f;
+		if (jitter_on) st.stat_jitter++;
+	}
+}
+
+void VKGSRender::r2aa_on_flip()
+{
+	auto& st = g_r2;
+	if (r2cfg().mode || r2cfg().debug)
+	{
+		static auto t0 = std::chrono::steady_clock::now();
+		static u32 flips = 0;
+		++flips;
+		const auto now = std::chrono::steady_clock::now();
+		const float sec = std::chrono::duration<float>(now - t0).count();
+		if (sec >= 5.f)
+		{
+			r2log("fps %.1f (%s) runs %u resets %u jittered %u empty-flips %u writeback-misses %u cpu %.0f us/run", flips / sec, st.scene_valid ? "scene" : "no scene",
+				st.stat_runs, st.stat_resets, st.stat_jitter, st.stat_flips_noscene, st.stat_wb_miss,
+				st.stat_run_n ? static_cast<double>(st.stat_run_ns) / 1000.0 / st.stat_run_n : 0.0);
+			st.stat_runs = st.stat_resets = st.stat_jitter = st.stat_flips_noscene = st.stat_wb_miss = 0;
+			st.stat_run_ns = 0;
+			st.stat_run_n = 0;
+			flips = 0;
+			t0 = now;
+		}
+	}
+	if (!r2cfg().mode) return;
+	// A backend that failed mid-frame (st.disabled) may have left the reduced-scale scene window open:
+	// still restore the full scale below, then stay inert.
+	if (st.disabled && !st.window && !st.section) return;
+	if (!st.draw_index) st.stat_flips_noscene++;
+
+	if (!st.disabled && r2cfg().split && st.scene_valid && st.flips_since < 3)
+	{
+		// The next frame's pre-pass straddles the flip: the logical frame ends after the upscaler (frame_boundary)
+		st.flips_since++;
+		if (st.section)
+		{
+			r2aa_set_section(false); // re-enabled at the next bind inside the window
+			if (m_draw_fbo)
+			{
+				if (vk::is_renderpass_open(*m_current_command_buffer)) vk::end_renderpass(*m_current_command_buffer);
+				m_draw_fbo->release();
+				m_draw_fbo = nullptr;
+			}
+			m_ctx->graphics_state.set(rsx::rtt_config_dirty);
+		}
+		return;
+	}
+
+	if (!st.disabled && st.scene_draws && !st.aa_done)
+	{
+		r2aa_run();
+	}
+	if (st.window || st.section)
+	{
+		st.window = false;
+		if (st.section)
+		{
+			// The bound framebuffer was built at the reduced scale: force a full rebind at the restored scale
+			r2aa_set_section(false);
+			if (m_draw_fbo)
+			{
+				if (vk::is_renderpass_open(*m_current_command_buffer)) vk::end_renderpass(*m_current_command_buffer);
+				m_draw_fbo->release();
+				m_draw_fbo = nullptr;
+			}
+			m_ctx->graphics_state.set(rsx::rtt_config_dirty);
+		}
+	}
+	if (st.wb_pending || st.wb_armed) { st.stat_wb_miss++; st.jitter_cooldown = 10; }
+	st.wb_pending = st.wb_armed = false;
+	st.resolve_wait = false;
+	if (st.disabled)
+	{
+		st.jx = st.jy = st.baked_x = st.baked_y = 0.f;
+		return;
+	}
+
+	frame_boundary();
+}
+namespace
+{
+	void release_backend()
+	{
+#ifdef R2PORT_HAVE_FFX
+		if (g_ffx.ctx)
+		{
+			g_ffx.destroy(&g_ffx.ctx, nullptr);
+			g_ffx.ctx = nullptr;
