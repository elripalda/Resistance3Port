diff --git a/rpcs3/Emu/RSX/port_backoff.h b/rpcs3/Emu/RSX/port_backoff.h
new file mode 100644
index 0000000..830d098
--- /dev/null
+++ b/rpcs3/Emu/RSX/port_backoff.h
@@ -0,0 +1,43 @@
+#pragma once
+
+// Port: bounded spin for RSX wait loops. Pure pause-spinning is fine with spare cores, but on a
+// 4-core CPU the spinner steals the core the producer (offloader, SPU, driver) needs, which made
+// frame rate collapse. Spin ~4 us for the low-latency case, then give the core away.
+#include "util/asm.hpp"
+#include <thread>
+
+#ifdef _WIN32
+extern "C" __declspec(dllimport) void __stdcall Sleep(unsigned long);
+#endif
+extern "C" int ps3_host_prio_boost(); // 1 = >= 8 logical CPUs: keep the original pure spin
+
+namespace rsx
+{
+	struct port_backoff
+	{
+		unsigned n = 0;
+
+		void operator()()
+		{
+			static const bool big = ps3_host_prio_boost() != 0;
+			if (big || n < 64)
+			{
+				utils::pause();
+			}
+			else if (n < 256)
+			{
+				std::this_thread::yield();
+			}
+			else
+			{
+#ifdef _WIN32
+				::Sleep(0);
+#else
+				std::this_thread::yield();
+#endif
+			}
+
+			if (n < 0xFFFF) n++;
+		}
+	};
+}
