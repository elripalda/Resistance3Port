--- /dev/null
+++ b/rpcs3/Emu/RSX/VK/VKR2Upscaler.h
@@ -0,0 +1,22 @@
+// R2PORT: Resistance 2 port addition (not upstream RPCS3).
+// Temporal anti-aliasing of the 3D scene with AMD FSR 3.1 (FidelityFX API, amd_fidelityfx_vk.dll) or
+// NVIDIA DLAA (r2_dlss.dll, NGX). Enabled by RSX_FSR=1 (FSR 3.1) / RSX_FSR=2 (DLAA, FSR fallback);
+// everything here is inert when RSX_FSR is unset or 0. The renderer hooks live in VKGSRender (r2aa_*).
+#pragma once
+
+#include "VulkanAPI.h"
+#include <vector>
+
+namespace vk
+{
+	// 0 off, 1 FSR 3.1, 2 DLAA (from RSX_FSR)
+	int r2aa_mode();
+
+	// instance.cpp: add the instance extensions NGX needs (RSX_FSR=2 only)
+	void r2aa_extend_instance(std::vector<const char*>& extensions);
+
+	// device.cpp, right before vkCreateDevice: enable the features/extensions FSR 3.1 and NGX use.
+	// Chains its own feature structs into 'info' and re-points the extension list at 'extensions'.
+	void r2aa_extend_device(VkPhysicalDevice pdev, std::vector<const char*>& extensions,
+		VkPhysicalDeviceFeatures& features, VkPhysicalDeviceVulkan12Features& vulkan12, VkDeviceCreateInfo& info);
+}
