+// R2PORT: clang-cl has no _div128/_udiv128 intrinsics; provide them with div/idiv
+// (same semantics as the MSVC intrinsics, and no compiler-rt __udivti3 dependency).
+inline long long _div128(long long high, long long low, long long divisor, long long* remainder)
+{
+	long long q, r;
+	__asm__("idivq %4" : "=a"(q), "=d"(r) : "a"(low), "d"(high), "rm"(divisor) : "cc");
+	*remainder = r;
+	return q;
+}
+
+inline unsigned long long _udiv128(unsigned long long high, unsigned long long low, unsigned long long divisor, unsigned long long* remainder)
+{
+	unsigned long long q, r;
+	__asm__("divq %4" : "=a"(q), "=d"(r) : "a"(low), "d"(high), "rm"(divisor) : "cc");
+	*remainder = r;
+	return q;
+}
+#endif
