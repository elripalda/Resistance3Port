+	// ---- r2_dlss.dll (project/r2_dlss.cpp) ----
+	typedef void (*r2_dlss_log_fn)(const char*);
+	struct dlss_api
+	{
+		HMODULE dll = nullptr;
+		bool tried = false;
+		bool usable = false;   // init succeeded
+		bool failed = false;   // give up, use FSR
+		int (*required_extensions)(unsigned*, const char***, unsigned*, const char***) = nullptr;
+		int (*init)(VkInstance, VkPhysicalDevice, VkDevice, PFN_vkGetInstanceProcAddr, PFN_vkGetDeviceProcAddr, const wchar_t*, r2_dlss_log_fn) = nullptr;
+		void (*release)() = nullptr;
+		int (*create)(VkCommandBuffer, unsigned, unsigned, unsigned, unsigned, int, unsigned) = nullptr;
+		int (*eval)(VkCommandBuffer, VkImage, VkImageView, int, VkImage, VkImageView, int, VkImage, VkImageView, int,
+			VkImage, VkImageView, int, unsigned, unsigned, float, float, float, float, int, float) = nullptr;
+		void (*set_mask)(VkImage, VkImageView, int) = nullptr; // optional (older bridges lack it)
+		unsigned inst_count = 0, dev_count = 0;
+		const char** inst_exts = nullptr;
+		const char** dev_exts = nullptr;
+	} g_dlss;
+
+	void dlss_log(const char* msg) { r2log("DLSS: %s", msg); }
+
+	bool dlss_load()
+	{
+		if (g_dlss.tried) return g_dlss.dll != nullptr;
+		g_dlss.tried = true;
+		const std::wstring path = exe_dir() + L"\\r2_dlss.dll";
+		g_dlss.dll = LoadLibraryW(path.c_str());
+		if (!g_dlss.dll)
+		{
+			r2aa_fallback(2, "r2_dlss.dll not found next to the game");
+			return false;
+		}
+		g_dlss.required_extensions = reinterpret_cast<decltype(g_dlss.required_extensions)>(GetProcAddress(g_dlss.dll, "r2_dlss_required_extensions"));
+		g_dlss.init = reinterpret_cast<decltype(g_dlss.init)>(GetProcAddress(g_dlss.dll, "r2_dlss_init"));
+		g_dlss.release = reinterpret_cast<decltype(g_dlss.release)>(GetProcAddress(g_dlss.dll, "r2_dlss_release"));
+		g_dlss.create = reinterpret_cast<decltype(g_dlss.create)>(GetProcAddress(g_dlss.dll, "r2_dlss_create"));
+		g_dlss.eval = reinterpret_cast<decltype(g_dlss.eval)>(GetProcAddress(g_dlss.dll, "r2_dlss_eval"));
+		g_dlss.set_mask = reinterpret_cast<decltype(g_dlss.set_mask)>(GetProcAddress(g_dlss.dll, "r2_dlss_set_mask"));
+		if (!g_dlss.required_extensions || !g_dlss.init || !g_dlss.release || !g_dlss.create || !g_dlss.eval)
+		{
+			r2aa_fallback(2, "r2_dlss.dll is incomplete");
+			g_dlss.dll = nullptr;
+			return false;
+		}
+		if (!g_dlss.required_extensions(&g_dlss.inst_count, &g_dlss.inst_exts, &g_dlss.dev_count, &g_dlss.dev_exts))
+		{
+			g_dlss.inst_count = g_dlss.dev_count = 0;
+		}
+		return true;
+	}
+
+	void push_unique(std::vector<const char*>& v, const char* name)
+	{
+		for (const char* e : v)
+			if (std::strcmp(e, name) == 0) return;
+		v.push_back(name);
+	}
+
