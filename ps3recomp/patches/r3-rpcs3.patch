+// R2PORT: Resistance 2 port addition (not upstream RPCS3). See VKR2Upscaler.h.
+//
+// How it works (all inert unless RSX_FSR=1/2):
+//  * Scene detection: every draw is tallied by (colour target, depth target). At each flip the pair with
+//    the most depth-tested draws becomes next frame's "scene".
+//  * Jitter: draws into the scene depth buffer get a Halton(2,3) sub-pixel offset added to the viewport
+//    offset of RPCS3's scale_offset matrix (vertex env), so no shader changes are needed.
+//  * Motion: the RSX vertex program of scene draws is run on the CPU for 4 basis points to get its
+//    affine object->clip matrix M. For each draw also seen last frame, R = M_prev * M_cur^-1; the most
+//    common R (static geometry) is the camera motion. A compute pass turns depth + R into motion vectors.
+//  * The upscaler (FSR 3.1 or DLAA, native resolution) runs when the scene colour is first read
+//    (post-processing / blit) or at flip, and its result is copied back into the scene colour target.
+
+#include "stdafx.h"
+#include "VKR2Upscaler.h"
+#include "VKGSRender.h"
+#include "VKCompute.h"
+#include "VKHelpers.h"
+#include "VKRenderPass.h"
+#include "VKResourceManager.h"
+#include "vkutils/barriers.h"
+#include "vkutils/sampler.h"
+
+#include "Emu/RSX/rsx_methods.h"
+#include "Emu/RSX/NV47/HW/context_accessors.define.h"
+
+#ifdef R2PORT_HAVE_FFX
+#include "ffx_api/ffx_api.h"
+#include "ffx_api/ffx_upscale.h"
+#include "ffx_api/vk/ffx_api_vk.h"
+#endif
