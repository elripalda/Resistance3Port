+{
+	inline bool enabled = false;
+	// rsx::thread is between core_renderer::begin() and the end of the draw
+	inline bool in_draw = false;
+	// rsx::thread is inside the fb-bind lock phase (VirtualProtect attribution)
+	inline thread_local bool in_fbb = false;
+
