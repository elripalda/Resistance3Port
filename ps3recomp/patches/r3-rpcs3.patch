+	{
+		std::atomic<uint64_t> frames{0}, draws{0}, submits{0};
+		// rsx::profiling_timer phases (µs), summed from frame_statistics_t
+		std::atomic<uint64_t> setup_us{0}, program_us{0}, vertex_us{0}, texture_us{0}, exec_us{0}, flip_us{0};
+		// core_renderer::begin(): framebuffer bind + backend begin_draw (µs)
+		std::atomic<uint64_t> fb_ns{0};
+		// begin() .. post_draw_hook() wall time of all draws (ns)
+		std::atomic<uint64_t> draw_ns{0};
+		std::atomic<uint64_t> vtx_cache_req{0}, vtx_cache_miss{0}, prog_lookups{0}, prog_elided{0};
+		// VKGSRender::flush_command_queue
+		std::atomic<uint64_t> flushes{0}, hard_syncs{0}, flush_ns{0};
+		// ZCULL report reads that had to wait on the host GPU
+		std::atomic<uint64_t> zcull_reads{0}, zcull_read_ns{0};
+		// Host page faults routed to rsx::g_access_violation_handler (bridge hook)
+		std::atomic<uint64_t> av_calls{0}, av_handled{0}, av_ns{0};
+		// Texture cache: flush_all on a fault (RSX-thread readback)
+		std::atomic<uint64_t> av_flushes{0};
+		// Round-2 breakdown counters, indexed by r2prof::xc (printed by name in the bridge)
+		std::atomic<uint64_t> x[128]{};
+	};
+
+	// Sub-phase counters. *_ns are nanoseconds, the rest are event counts.
+	enum xc : int
+	{
+		// on_framebuffer_bound (full rebinds only)
+		fbb_full, fbb_ignore, fbb_aa_ns, fbb_prep_ns, fbb_wcb_ns, fbb_wcb_copies, fbb_wcb_skipped, fbb_dma_flush,
+		fbb_lock_ns, fbb_rp_ns, fbb_total_ns,
+		// flush_command_queue callers
+		fl_zcull_hint, fl_zcull_hard, fl_av_request, fl_bind_dma,
+		// ZCULL
+		zc_sync_calls, zc_batch_calls, zc_batch_slots, zc_poll_loops, zc_flush_serviced,
+		// access violations that needed a GPU readback: wait for the RSX thread, then copy/wait
+		av_wait_ns, av_flush_ns, av_max_ns,
+		// vertex upload: layouts the weak cache cannot hold (multi-block / inline)
+		vtx_uncacheable,
+		// Round 3: rsx::thread time outside begin()..end() of draws (ns)
+		od_clear_ns, od_clears, od_fbb_ns, od_flush_ns, od_label_ns, od_blit_ns, od_flip_ns, od_house_ns, od_zcull_ns,
+		// DLSS/FSR hooks (VKR2Upscaler / pass dump call sites), total and the part inside draws (ns)
+		dlss_ns, dlss_draw_ns,
+		// Program resolve: backend lookup time (ns), why the cache hint was dropped
+		prog_lookup_ns, prog_vp_ucode, prog_fp_ucode, prog_vp_state, prog_fp_state,
+		// R3 only: program lookups answered by the ucode MRU (ProgramStateCache.h) instead of hash + map lookup
+		prog_mru_hits,
+		// Re-sent fragment / vertex programs kept without re-analysis (RSXGraphEngine, R2_FP_REBIND / R2_VP_REBIND),
+		// pipeline lookups answered by the last-pipeline memo (VKGSRender, R2_PIPE_MEMO)
+		prog_fp_rebind, prog_vp_rebind, prog_memo_hits,
+		// Deferred ZCULL labels (R2_ZCULL_DEFER)
+		zc_deferred, zc_released, zc_drain_block, zc_drain_ns, zc_fence_waits,
+		// Round 4: fb-bind lock phase split (ns), worst rebind lock time, rebinds whose lock phase took > 20 us
+		fbb_lk_discard_ns, fbb_lk_orphan_ns, fbb_lk_color_ns, fbb_lk_depth_ns, fbb_lk_max_ns, fbb_lk_slow,
+		// texture cache: m_cache_mutex wait on rsx::thread, invalidate_range_impl_base calls/ns/sections unprotected,
+		// lock_memory_region: already-locked relocks vs fresh locks (reset + protect)
+		tc_mutex_wait_ns, tc_inval_calls, tc_inval_ns, tc_unprotected, tc_relock, tc_fresh_lock,
+		// host VirtualProtect (utils::memory_protect): calls/ns on any thread, the part inside the fb-bind lock phase,
+		// calls skipped because VirtualQuery showed the pages already had that protection (R2_MM_SKIPSAME), pages
+		mm_vp_calls, mm_vp_ns, mm_vp_fbb_calls, mm_vp_fbb_ns, mm_vp_skipped, mm_vp_pages,
+		// g_mprotect_queue_lock wait on rsx::thread (ns); Offloader queue flushes
+		mm_qlock_wait_ns, mm_offload_flushes,
+		// flip_command split: frame limiter sleep, present (flip()), ZCULL labels carried over a flip (R2_ZCULL_FLIP_LAG)
+		od_limit_ns, od_present_ns, zc_flip_carried,
+		// program phase split (ns): ucode analysis (prefetch_*), load_program, transform constants (+bytes),
+		// fragment constants, remaining env/bind work in load_program_env
+		prog_analyse_ns, prog_load_ns, prog_xform_ns, prog_xform_bytes, prog_fconst_ns, prog_env_ns,
+		// R2_FBB_KEEP: rebinds avoided by keeping an unused depth / colour target bound
+		fbb_keep_depth, fbb_keep_color,
+		// Round 5: texture cache flush_set (blocking GPU readback) calls/ns/sections, the committed_as_fbo part,
+		// flushes skipped by R2_FBO_COMMIT_FLUSH=0 (sections fully overwritten by the new render target)
+		tc_flush_calls, tc_flush_ns, tc_flush_sections, tc_flush_commit_calls, tc_flush_commit_ns, tc_commit_skip,
+		// Round 5: load_program_env "rest" split (ns): vertex env, fragment texture env, bind_uniform calls, instancing,
+		// fragment env, DLSS/FSR draw hook (r2aa_on_draw, includes the AA run when it fires there)
+		pe_vtx_env_ns, pe_tex_env_ns, pe_bind_ns, pe_inst_ns, pe_frag_env_ns, pe_aa_ns,
+		// Round 6: flip_command split (od self ns): deferred-label drain/poll, reset() (ZCULL state), on_frame_end,
+		// the rest of the flip (handle_emu_flip outside limiter/present). ZCULL reads answered without waiting vs
+		// reads that had to wait for the GPU (fence), and the ns of those waits; reads by caller (update / sync / forced)
+		od_fl_drain_ns, od_fl_reset_ns, od_fl_end_ns, od_fl_emu_ns,
+		zc_read_ready, zc_read_wait, zc_read_wait_ns, zc_read_update, zc_read_forced,
+		// Round 7: draw "other" split (ns): core_renderer::begin() (incl. fb-bind), end() (incl. the phases), post_draw_hook;
+		// the rest of begin()..end of draw is method processing between begin and end.
+		dr_begin_ns, dr_end_ns, dr_post_ns,
+		// lock_memory_region_impl: superseded invalidation, create + reprotect (ns); why a lock was fresh (no section,
+		// section unlocked, section used for something else); superseded surfaces discarded in the fb-bind lock phase
+		lk_inval_ns, lk_create_ns, lk_fresh_noexist, lk_fresh_unlocked, lk_fresh_ctx, lk_superseded,
+		// invalidate_range_impl_base split (ns): get_intersecting_set, unprotect_set; sections discarded in the fast path
+		inval_isect_ns, inval_unprot_ns, inval_discards,
+		x_count
+	};
+	static_assert(x_count <= 128);
+
+	inline counters_t g;
+
+	// R2PORT round 7: the profiler reads the clock ~40 times per draw; rdtsc (invariant TSC, scaled once against QPC)
+	// costs a fraction of steady_clock::now() (QPC + 128-bit scaling), so R2_RSX_PROF disturbs the numbers less.
+	inline double tsc_ns_factor()
+	{
+#if defined(_WIN32) && (defined(_M_X64) || defined(__x86_64__))
+		const auto qpc = [] { return std::chrono::steady_clock::now(); };
+		const auto q0 = qpc();
+		const uint64_t r0 = __rdtsc();
+		while (qpc() - q0 < std::chrono::milliseconds(2)) {}
+		const auto q1 = qpc();
+		const uint64_t r1 = __rdtsc();
+		const double ns = static_cast<double>(std::chrono::duration_cast<std::chrono::nanoseconds>(q1 - q0).count());
+		return r1 > r0 ? ns / static_cast<double>(r1 - r0) : 0.0;
+#else
+		return 0.0;
+#endif
+	}
+
+	inline uint64_t now_ns()
+	{
+#if defined(_WIN32) && (defined(_M_X64) || defined(__x86_64__))
+		static const double k = tsc_ns_factor();
+		if (k > 0.0) [[likely]] return static_cast<uint64_t>(static_cast<double>(__rdtsc()) * k);
+#endif
+		return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+			std::chrono::steady_clock::now().time_since_epoch()).count());
+	}
+
+	inline void add(std::atomic<uint64_t>& c, uint64_t v)
+	{
+		c.fetch_add(v, std::memory_order_relaxed);
+	}
+
+	inline void addx(xc i, uint64_t v = 1)
+	{
+		if (enabled) g.x[i].fetch_add(v, std::memory_order_relaxed);
+	}
+
+	inline void maxx(xc i, uint64_t v)
+	{
+		if (!enabled) return;
+		uint64_t cur = g.x[i].load(std::memory_order_relaxed);
+		while (v > cur && !g.x[i].compare_exchange_weak(cur, v, std::memory_order_relaxed)) {}
+	}
+
+	// ns timer into g.x[i]
+	struct scope_x
+	{
+		xc i;
+		uint64_t t0;
+		explicit scope_x(xc idx) : i(idx), t0(enabled ? now_ns() : 0) {}
+		~scope_x() { if (t0) g.x[i].fetch_add(now_ns() - t0, std::memory_order_relaxed); }
+	};
+
+	// ns timer into g.x[i] that only counts outside draws. Self time: nested od scopes are subtracted from the outer one.
+	inline thread_local uint64_t od_child = 0;
+	struct scope_od
+	{
+		xc i;
+		uint64_t t0 = 0;
+		uint64_t saved = 0;
+		explicit scope_od(xc idx) : i(idx)
+		{
+			if (!enabled || in_draw) return;
+			saved = od_child;
+			od_child = 0;
+			t0 = now_ns();
+		}
+		~scope_od()
+		{
+			if (!t0) return;
+			const uint64_t total = now_ns() - t0;
+			const uint64_t self = total > od_child ? total - od_child : 0;
+			g.x[i].fetch_add(self, std::memory_order_relaxed);
+			od_child = saved + total;
+		}
+	};
+
+	// ns timer for the DLSS/FSR hooks: total, plus the in-draw part
+	struct scope_dlss
+	{
+		uint64_t t0;
+		bool draw;
+		scope_dlss() : t0(enabled ? now_ns() : 0), draw(in_draw) {}
+		~scope_dlss()
+		{
+			if (!t0) return;
+			const uint64_t d = now_ns() - t0;
+			g.x[dlss_ns].fetch_add(d, std::memory_order_relaxed);
+			if (draw) g.x[dlss_draw_ns].fetch_add(d, std::memory_order_relaxed);
+		}
+	};
+
+	struct scope_ns
+	{
+		std::atomic<uint64_t>* sink;
+		uint64_t t0;
+		explicit scope_ns(std::atomic<uint64_t>& c) : sink(enabled ? &c : nullptr), t0(sink ? now_ns() : 0) {}
+		~scope_ns() { if (sink) add(*sink, now_ns() - t0); }
+	};
+}
