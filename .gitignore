/project/spu/*/
/project/spu/jobmods_register.c
/tools/key_vault.cpp
/tools/ffmpeg_bin/
/tools/dlss/
/shadercache/

# build output / runtime files
/build/
/build_game/
/build_regen/
/logs/
/rsxcap/
/Launcher.exe
/settings.bat
/settings.ini
*.obj
*.pdb
*.ilk
__pycache__/

build_regen_spu/
logs_ppu.txt
logs_build.txt
/cache/
logs_build_*.txt
*.bak_*
/tools/shader_audit/out/
/tools/shader_audit/*.exe
/tools/shader_audit/*.txt

